---
/*
  Tabla de seguimiento: una fila por instrucción, en el orden en que se
  ejecuta, y una columna por casillero de la memoria con su valor *después*
  de esa instrucción. Lo que se muestra no es una columna: va aparte, en la
  última fila, porque la pantalla conserva lo que mostró aunque la memoria
  siga cambiando. Sin `memoria`, las celdas quedan en blanco para escribir.
*/
import { formatear, type Memoria } from "../data/actividad-cuando-importa-el-orden";

type FilaTabla = {
  numero: number;
  texto: string;
  memoria?: Memoria;
  muestra?: number;
};

interface Props {
  casilleros: readonly string[];
  inicial: Memoria;
  filas: readonly FilaTabla[];
  titulo?: string;
  /**
   * «pizarron»: valores para revelar paso a paso; «hoja»: ejemplo resuelto;
   * «clave»: compacta; «papelito»: celdas en blanco, altas, para escribir.
   */
  variante?: "pizarron" | "hoja" | "clave" | "papelito";
}

const { casilleros, inicial, filas, titulo, variante = "pizarron" } = Astro.props;

const resuelta = filas.some((fila) => fila.memoria);
const mostro = filas.findLast((fila) => fila.muestra !== undefined)?.muestra;
const anterior = (indice: number) => (indice === 0 ? inicial : filas[indice - 1].memoria);
---

<table class:list={["seguimiento", `seguimiento--${variante}`]}>
  {titulo && <caption>{titulo}</caption>}
  <thead>
    <tr>
      <th scope="col" class="col-instruccion">Después de ejecutar</th>
      {casilleros.map((casillero) => <th scope="col">{casillero}</th>)}
    </tr>
  </thead>
  <tbody>
    <tr class="fila-inicial">
      <th scope="row">Al empezar</th>
      {casilleros.map((casillero) => <td>{formatear(inicial[casillero] ?? 0)}</td>)}
    </tr>
    {filas.map((fila, indice) => (
      <tr data-instruccion={fila.numero} data-muestra={fila.muestra !== undefined ? "" : undefined}>
        <th scope="row">
          <span class="numero">{fila.numero}.</span>
          <span>{fila.texto}</span>
        </th>
        {casilleros.map((casillero) => (
          <td data-cambio={fila.memoria && fila.memoria[casillero] !== anterior(indice)?.[casillero] ? "" : undefined}>
            <span class="valor">{fila.memoria ? formatear(fila.memoria[casillero] ?? 0) : ""}</span>
          </td>
        ))}
      </tr>
    ))}
  </tbody>
  <tfoot>
    <tr class="fila-pantalla">
      <th scope="row">La pantalla mostró</th>
      <td colspan={casilleros.length}>
        <span class="valor">{resuelta && mostro !== undefined ? formatear(mostro) : ""}</span>
      </td>
    </tr>
  </tfoot>
</table>

<style>
  .seguimiento {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95em;
  }

  caption {
    margin-bottom: 0.35rem;
    font-weight: 700;
    text-align: left;
  }

  th,
  td {
    padding: 0.35rem 0.55rem;
    border: 1.5px solid var(--line);
    text-align: left;
    vertical-align: middle;
  }

  thead th {
    font-size: 0.85em;
    letter-spacing: 0.04em;
  }

  /* Las columnas de valores se ajustan a su contenido; la instrucción usa el
     resto del ancho. */
  thead th:not(:first-child),
  tbody td {
    width: 1%;
    white-space: nowrap;
  }

  td {
    min-width: 3.5em;
    text-align: center;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  tbody th {
    font-weight: 600;
  }

  .numero {
    margin-right: 0.35em;
    font-weight: 700;
  }

  .fila-inicial th,
  .fila-inicial td {
    background: color-mix(in srgb, var(--line) 6%, transparent);
  }

  .fila-inicial th {
    font-style: italic;
  }

  /* La pantalla, separada de la memoria por un borde doble. */
  .fila-pantalla th,
  .fila-pantalla td {
    border-top: 4px double var(--line);
  }

  .fila-pantalla th {
    font-weight: 700;
  }

  .seguimiento--pizarron td {
    min-width: 2.6em;
  }

  .seguimiento--pizarron tbody th {
    line-height: 1.35;
  }

  .seguimiento--papelito td,
  .seguimiento--papelito th {
    height: 2.6rem;
  }

  @media (max-width: 30rem) {
    .seguimiento {
      font-size: 0.88em;
    }

    th,
    td {
      padding: 0.3rem 0.35rem;
    }
  }

  @media print {
    .seguimiento {
      font-size: 10pt;
      break-inside: avoid;
    }

    caption {
      margin-bottom: 1mm;
    }

    th,
    td {
      padding: 0.6mm 2mm;
      border: 0.75pt solid #000;
      color: #000;
    }

    thead th:not(:first-child),
    tbody td {
      width: 17mm;
    }

    .fila-inicial th,
    .fila-inicial td {
      background: none;
    }

    .fila-pantalla th,
    .fila-pantalla td {
      border-top: 2.5pt double #000;
    }

    .seguimiento--clave {
      font-size: 9pt;
    }

    .seguimiento--clave thead th:not(:first-child),
    .seguimiento--clave tbody td {
      width: 13mm;
    }

    /* Renglones cómodos para escribir a mano. */
    .seguimiento--papelito {
      font-size: 10.5pt;
    }

    .seguimiento--papelito tbody th,
    .seguimiento--papelito tbody td,
    .seguimiento--papelito tfoot th,
    .seguimiento--papelito tfoot td {
      height: 9mm;
    }

    .seguimiento--papelito thead th:not(:first-child),
    .seguimiento--papelito tbody td {
      width: 20mm;
    }
  }
</style>
