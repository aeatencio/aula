---
import type { NavegacionRecorrido as DatosNavegacion } from "../data/recorridos";

interface Props {
  navegaciones: DatosNavegacion[];
}

const { navegaciones } = Astro.props;
---

{
  navegaciones.length > 0 && (
    <div class="navegacion-recorrido" data-navegacion-recorrido>
      {navegaciones.map((navegacion) => (
        <nav
          class="recorrido"
          hidden
          data-recorrido-id={navegacion.id}
          data-recorrido-materiales={JSON.stringify(navegacion.materiales)}
          aria-label={`Recorrido ${navegacion.nombre}`}
        >
          <p class="recorrido-contexto">
            Paso {navegacion.paso} de {navegacion.total}
            {" · "}
            <a href={navegacion.href}>{navegacion.nombre}</a>
            {" · "}
            <a
              class="recorrido-salir"
              href={navegacion.salirHref}
              data-recorrido-salir
            >
              Salir del recorrido
            </a>
          </p>
          {(navegacion.anterior || navegacion.siguiente) && (
            <div class="recorrido-vecinos">
              {navegacion.anterior && (
                <a
                  class="recorrido-vecino recorrido-vecino--anterior"
                  href={navegacion.anterior.href}
                  rel="prev"
                  aria-label={`Anterior: ${navegacion.anterior.title}`}
                >
                  ← Anterior
                </a>
              )}
              {navegacion.siguiente && (
                <a
                  class="recorrido-vecino recorrido-vecino--siguiente"
                  href={navegacion.siguiente.href}
                  rel="next"
                  aria-label={`Siguiente: ${navegacion.siguiente.title}`}
                >
                  Siguiente →
                </a>
              )}
            </div>
          )}
        </nav>
      ))}
      <script>
        import { iniciarNavegacionRecorrido } from "../scripts/navegacion-recorrido";

        iniciarNavegacionRecorrido();
      </script>
    </div>
  )
}

<style>
  .recorrido {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.15rem;
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .recorrido[hidden] {
    display: none;
  }

  .recorrido-contexto {
    margin: 0;
    overflow-wrap: break-word;
  }

  .recorrido-vecinos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    margin: 0;
  }

  .recorrido a {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
  }

  .recorrido a:hover {
    color: var(--accent);
  }

  .recorrido .recorrido-salir {
    color: var(--muted);
    font-weight: 600;
    border-bottom-color: var(--line);
  }

  .recorrido-vecino {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.35rem 0.15rem;
  }

  .recorrido-vecino--siguiente {
    margin-inline-start: auto;
  }

  @media print {
    .navegacion-recorrido {
      display: none;
    }
  }
</style>

<style is:global>
  a[data-recorrido-salida]::after {
    content: " · fuera del recorrido";
    color: var(--muted);
    font-size: 0.8em;
    font-weight: 600;
  }

  a.accion--principal[data-recorrido-salida]::after {
    color: inherit;
  }

  @media print {
    a[data-recorrido-salida]::after {
      content: none;
    }
  }
</style>
