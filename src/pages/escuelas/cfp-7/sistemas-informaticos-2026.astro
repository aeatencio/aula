---
import {
  hrefConRecorrido,
  requireRecorrido,
} from "../../../data/recorridos";
import Layout from "../../../layouts/Layout.astro";

const recorrido = requireRecorrido("cfp7-si-2026");
---

<Layout
  title={`${recorrido.nombre} · Aula`}
  description="Materiales del recorrido de Sistemas Informáticos en CFP 7 durante 2026."
  current="escuelas"
>
  <p class="ubicacion-recorrido">Escuelas · CFP 7</p>
  <h1 class="page-title">{recorrido.nombre}</h1>
  <p class="lede">
    Materiales de este recorrido de enseñanza.
  </p>

  <ol class="lista-pizarrones">
    {recorrido.materiales.map((material) => (
      <li>
        <a href={hrefConRecorrido(material.href, recorrido.id)}>
          {material.title}
        </a>
        {material.tipo && (
          <span class="tipo-material">{material.tipo}</span>
        )}
      </li>
    ))}
  </ol>
</Layout>

<style>
  .ubicacion-recorrido {
    margin: 0 0 0.45rem;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .lista-pizarrones {
    list-style: decimal;
    padding-left: 1.7rem;
  }

  .lista-pizarrones li::marker {
    color: var(--muted);
    font-weight: 700;
  }

  .tipo-material {
    margin-left: 0.45rem;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
