    margin-top: 1mm;
  }

  /* Dorso */
  .referencia {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 5mm;
    margin: 0 0 3mm;
    padding: 2mm 3.5mm;
    border: 1pt solid #000;
    font-size: 9.5pt;
  }

  .referencia dl {
    display: grid;
    gap: 0.3mm;
    margin: 0;
  }

  .referencia dt {
    display: inline;
    font-weight: 700;
  }

  .referencia dt::after {
    content: ": ";
  }

  .referencia dd {
    display: inline;
    margin: 0;
  }

  .tramo {
    margin: 3.5mm 0 1.5mm !important;
    padding-top: 1.5mm;
    border-top: 1pt solid #000;
  }

  .items {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5mm 4mm;
  }

  .item {
    padding: 2.5mm 3mm;
    border: 1pt solid #000;
  }

  .item--ancho {
    grid-column: 1 / -1;
  }

  .pares {
    display: flex;
    flex-wrap: wrap;
    gap: 3mm 8mm;
    align-items: flex-start;
    margin-bottom: 2mm;
    font-size: 9.5pt;
  }

  .pares--fila {
    margin-top: 3mm;
  }

  .preguntas {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .preguntas li {
    display: flex;
    gap: 1.5mm;
  }

  .preguntas li + li {
    margin-top: 1mm;
  }

  .num {
    flex: none;
    min-width: 5.5mm;
    font-weight: 800;
  }

  .secuencia-nombre {
    margin-bottom: 1.5mm !important;
    font-weight: 800;
  }

  .secuencia {
    margin-left: 2mm;
    font-size: 13pt;
    letter-spacing: 0.12em;
  }

  .pie {
    position: absolute;
    left: 12mm;
    right: 12mm;
    bottom: 6mm;
    display: flex;
    justify-content: space-between;
    padding-top: 1mm;
    border-top: 0.5pt solid #000;
    font-size: 7.5pt;
  }

  @page {
    size: A4;
    margin: 0;
  }

  @media print {
    :global(.material > .apertura),
    .aviso {
      display: none;
    }

    :global(.material) {
      max-width: none;
    }

    .hojas {
      overflow: visible;
    }

    .pagina {
      margin: 0;
      border: 0;
      break-after: page;
    }

    .pagina:last-child {
      break-after: auto;
    }
  }
</style>
