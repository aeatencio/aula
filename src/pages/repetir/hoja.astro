    display: flex;
    flex-wrap: wrap;
    gap: 2mm 3mm;
    align-items: flex-start;
    margin-bottom: 1.5mm;
    font-size: 9pt;
  }

  .da {
    font-size: 9pt;
  }

  .respaldo {
    padding: 2mm 3.5mm;
    border: 1pt dashed #000;
    font-size: 9.5pt;
  }

