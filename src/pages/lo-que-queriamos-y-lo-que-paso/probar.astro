---
import { ideaFinal, instrucciones } from "../../data/actividad-lo-que-queriamos";
import { serieLoQueQueriamos } from "../../data/serie-lo-que-queriamos";
import MaterialLayout from "../../layouts/MaterialLayout.astro";
import { pesos, predicciones } from "../../scripts/probar-y-ajustar";
---

<MaterialLayout
  title="Probar y ajustar el programa"
  description="Práctica en pantalla de Pensamiento Computacional: predecir qué muestra un programa breve, ejecutarlo paso a paso y reordenar sus instrucciones hasta que haga lo que se quería."
  tipo="Práctica"
  bajada="Predecir, ejecutar paso a paso y ordenar las instrucciones"
  serie={serieLoQueQueriamos}
  tituloPizarrones="Para recuperar"
  imprimirPie={false}
>
  <p class="solo-impresion">
    Esta práctica es para hacer en pantalla. Para trabajar en papel está la hoja
    «Lo que queríamos y lo que pasó».
  </p>

  {/* tabindex="-1": un clic en cualquier parte de la práctica deja el foco
      dentro de la región, y las flechas no cambian de material. */}
  <div class="practica" data-probar-y-ajustar data-navegacion-recorrido-excluir tabindex="-1">
    <noscript>
      <p class="aviso">
        Esta práctica necesita JavaScript. Sin él, podés resolver la hoja{" "}
        <a href="/lo-que-queriamos-y-lo-que-paso/">Lo que queríamos y lo que pasó</a>.
      </p>
    </noscript>

    <section class="parte" aria-labelledby="pedido">
      <h2 id="pedido">El pedido</h2>
      <div class="caso">
        <p>
          Una tienda vende por internet. La dueña quiere descontar el 10&nbsp;% sólo
          del precio del producto y cobrar el envío completo. Por ejemplo, por una
          campera de $10.000 con $2.000 de envío quiere cobrar $11.000.
        </p>
        <p>
          La máquina no sabe lo que la dueña quiere: actúa según los datos de cada
          compra y las instrucciones de su programa. Las ejecuta una por una, en
          el orden en que están escritas. El total empieza en $0.
        </p>
      </div>
    </section>

    <section class="parte" aria-labelledby="predecir">
      <h2 id="predecir"><span class="parte-nro">1</span> Predecir y ejecutar</h2>
      <p>
        Este es el programa que se escribió. Antes de ejecutarlo con la campera,
        predecí qué va a mostrar la pantalla.
      </p>

      <fieldset class="prediccion">
        <legend>¿Qué va a mostrar la pantalla?</legend>
        <div class="prediccion-opciones">
          {predicciones.map((valor) => (
            <label class="opcion">
              <input type="radio" name="prediccion" value={valor} autocomplete="off" />
              <span>{pesos(valor)}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <table class="traza" data-traza>
        <caption>Ejecución con la campera ($10.000 + $2.000 de envío)</caption>
        <thead>
          <tr>
            <th scope="col">Instrucción</th>
            <th scope="col">Total</th>
          </tr>
        </thead>
        <tbody>
          {instrucciones.map((instruccion, indice) => (
            <tr>
              <th scope="row">{indice + 1}. {instruccion}</th>
              <td data-total>—</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="pantalla">Pantalla: <strong data-pantalla>—</strong></p>

      <div class="acciones" data-con-script hidden>
        <button type="button" class="accion accion--principal" data-paso>
          Ejecutar la primera instrucción
        </button>
        <button type="button" class="accion" data-reiniciar-traza>
          Volver a empezar
        </button>
      </div>
      <p class="estado" data-estado-traza role="status" aria-live="polite"></p>
    </section>

    <section class="parte" aria-labelledby="ajustar">
      <h2 id="ajustar"><span class="parte-nro">2</span> Ajustar el programa</h2>
      <p>
        Cambiá el orden de las instrucciones con Subir y Bajar. Después probá el
        programa con tres compras distintas: tiene que servir para cualquiera.
      </p>

      <ol class="programa" data-programa aria-label="Programa">
        {instrucciones.map((instruccion) => <li>{instruccion}</li>)}
      </ol>

      <div class="acciones" data-con-script hidden>
        <button type="button" class="accion accion--principal" data-probar>
          Probar con tres compras
        </button>
        <button type="button" class="accion" data-restaurar>
          Volver al programa original
        </button>
      </div>

      <table class="resultados" data-resultados hidden>
        <caption>Lo que muestra la pantalla con cada compra</caption>
        <thead>
          <tr>
            <th scope="col">Compra</th>
            <th scope="col">Pantalla</th>
            <th scope="col">La dueña quería</th>
            <th scope="col">¿Coincide?</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
      <p class="estado" data-estado-ajuste role="status" aria-live="polite"></p>
    </section>

    <section class="parte llevarte" aria-labelledby="llevarte">
      <h2 id="llevarte">Para llevarte</h2>
      <p>{ideaFinal}</p>
      <p>
        Para volver a mirar la idea:{" "}
        <a href="/pizarrones/la-maquina-obedece-exactamente/">
          La máquina obedece exactamente
        </a>.
      </p>
    </section>
  </div>
</MaterialLayout>

<script>
  import { iniciarProbarYAjustar } from "../../scripts/probar-y-ajustar";

  iniciarProbarYAjustar();
</script>

<style>
  .solo-impresion {
    display: none;
  }

  .practica:focus {
    outline: none;
  }

  .aviso {
    font-weight: 600;
  }

  .parte + .parte {
    margin-top: 2.25rem;
  }

  .parte h2 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 0.85rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--line);
    font-size: clamp(1.2rem, 0.35vw + 1.1rem, 1.45rem);
    line-height: 1.25;
  }

  .parte-nro {
    color: var(--accent);
  }

  .parte p {
    margin: 0 0 0.85rem;
  }

  .caso {
    padding: 0.9rem 1rem;
    border: 2px solid var(--line);
    background: var(--board);
  }

  .caso p:last-child {
    margin-bottom: 0;
  }

  .prediccion {
    min-width: 0;
    margin: 0 0 1.1rem;
    padding: 0.7rem 0.8rem 0.85rem;
    border: 2px solid var(--hairline);
    background: var(--board);
  }

  /* float lleva el legend dentro del marco, sin cortar el borde superior,
     como en las preguntas de la hoja. */
  .prediccion legend {
    float: left;
    width: 100%;
    margin: 0 0 0.6rem;
    padding: 0;
    font-weight: 700;
  }

  .prediccion-opciones {
    clear: both;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .opcion {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.85rem;
    padding: 0.4rem 0.7rem;
    border: 2px solid var(--hairline);
    background: var(--paper);
    font-weight: 600;
    cursor: pointer;
  }

  .opcion:hover {
    border-color: var(--accent);
  }

  .opcion:has(input:checked) {
    border-color: var(--ink);
    background: color-mix(in srgb, var(--accent) 10%, var(--board));
    font-weight: 700;
  }

  .opcion:has(input:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .opcion input {
    width: 1.15rem;
    height: 1.15rem;
    margin: 0;
    accent-color: var(--ink);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 0.75rem;
    background: var(--board);
    font-size: 1rem;
  }

  caption {
    margin-bottom: 0.4rem;
    font-weight: 700;
    text-align: left;
  }

  /* Las filas de resultados las crea el script: necesitan :global. */
  th,
  td,
  .resultados :global(th),
  .resultados :global(td) {
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--line);
    text-align: left;
    font-weight: 400;
  }

  thead th {
    font-weight: 700;
  }

  .traza td,
  .resultados :global(td) {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .traza tr[aria-current="step"] {
    background: color-mix(in srgb, var(--accent) 14%, var(--board));
    font-weight: 700;
  }

  .traza tr[aria-current="step"] th {
    font-weight: 700;
  }

  .resultados :global(tr[data-coincide="true"] td:last-child) {
    color: var(--accent);
    font-weight: 700;
  }

  .resultados :global(tr[data-coincide="false"] td:last-child) {
    color: var(--emphasis);
    font-weight: 700;
  }

  .resultados[hidden] {
    display: none;
  }

  .pantalla {
    font-size: 1.1rem;
  }

  .programa {
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
    counter-reset: instruccion;
  }

  .programa :global(li) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 0.8rem;
    padding: 0.45rem 0.6rem;
    border: 2px solid var(--hairline);
    border-left: 6px solid var(--accent);
    background: var(--board);
    counter-increment: instruccion;
  }

  .programa :global(li + li) {
    margin-top: 0.4rem;
  }

  .programa :global(.instruccion) {
    font-weight: 700;
  }

  .programa :global(.instruccion)::before {
    content: counter(instruccion) ". ";
  }

  .programa :global(.controles) {
    display: flex;
    gap: 0.4rem;
  }

  .programa :global(.mover) {
    min-width: 4.5rem;
    min-height: 2.6rem;
    padding: 0.3rem 0.7rem;
    border: 2px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
  }

  .programa :global(.mover:hover:not(:disabled)) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .programa :global(.mover:disabled) {
    border-color: var(--hairline);
    color: var(--muted);
    cursor: default;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 0.5rem 0 0.75rem;
  }

  .acciones[hidden] {
    display: none;
  }

  .accion {
    appearance: none;
    min-height: 2.85rem;
    padding: 0.55rem 1.15rem;
    border: 2px solid var(--line);
    background: var(--board);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .accion:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .accion:disabled {
    border-color: var(--hairline);
    color: var(--muted);
    cursor: default;
  }

  .accion--principal:not(:disabled) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--board);
  }

  .accion--principal:hover:not(:disabled) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--board);
  }

  .estado {
    min-height: 1.5em;
    font-weight: 700;
    line-height: 1.45;
  }

  .llevarte p:first-of-type {
    padding-left: 1rem;
    border-left: 4px solid var(--emphasis);
    font-weight: 700;
  }

  .llevarte a {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
  }

  @media (max-width: 36rem) {
    .prediccion-opciones {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Es una práctica para la pantalla: al imprimir sólo queda la indicación de
     la hoja en papel, sin controles ni resultados. */
  @media print {
    .practica {
      display: none;
    }

    .solo-impresion {
      display: block;
      font-weight: 700;
    }
  }
</style>
