---
import TablaSeguimiento from "../../components/TablaSeguimiento.astro";
import {
  pedido,
  casoPedido,
  ordenPedidoCambiado,
  preguntaInicial,
  seguir,
  verbos,
} from "../../data/actividad-cuando-importa-el-orden";
import PizarronLayout from "../../layouts/PizarronLayout.astro";

const ejecuciones = [
  { titulo: "Como está escrito", orden: [1, 2, 3] },
  { titulo: "Intercambiando la 1 y la 2", orden: ordenPedidoCambiado },
];
---

<PizarronLayout
  title="Seguir un programa paso a paso"
  description="Dos órdenes para un mismo programa: predecí qué muestran, ejecutá una instrucción por vez y compará los valores en una tabla de seguimiento."
  categoria="Pensamiento Computacional"
  encabezado="simple-grande"
>
  <p class="pregunta">{preguntaInicial}</p>
  <p class="caso">{casoPedido}</p>
  <p class="prediccion">¿Los dos órdenes van a mostrar el mismo total? ¿Cuánto va a mostrar cada uno?</p>

  <div class="ejecuciones">
    {ejecuciones.map(({ titulo, orden }, indice) => (
      <section class="ejecucion" data-ejecucion aria-labelledby={`orden-${indice}`}>
        <h2 id={`orden-${indice}`}>{titulo}</h2>
        <TablaSeguimiento
          titulo={`Orden ${orden.join(" · ")}`}
          casilleros={pedido.casilleros}
          inicial={pedido.inicial}
          filas={seguir(pedido, orden)}
        />
        <div class="controles" hidden>
          <p class="paso" role="status" aria-atomic="true"></p>
          <div class="botones">
            <button type="button" data-siguiente>Ejecutar instrucción {orden[0]}</button>
            <button type="button" data-reiniciar disabled>Volver a empezar</button>
          </div>
        </div>
      </section>
    ))}
  </div>

  <p class="comparacion" data-comparacion>
    Compará las tablas: ¿cuánto vale CANTIDAD cuando se calcula TOTAL en cada orden?
    ¿Qué cambiarías en el segundo programa para que muestre el total del pedido?
  </p>

  <section class="referencia" aria-labelledby="tabla-titulo">
    <h2 id="tabla-titulo">Cómo leer la tabla de seguimiento</h2>
    <p>
      La memoria guarda los valores en casilleros con nombre: acá, CANTIDAD y TOTAL.
      Cada fila muestra cómo quedan <strong>después</strong> de ejecutar una instrucción,
      aunque no hayan cambiado. Los números identifican las instrucciones del programa original.
    </p>
    <p>
      En «Pantalla» se anota un valor sólo en la fila de «Mostrar».
      Una celda vacía no significa que se borre la pantalla.{" "}
      <span class="leyenda" hidden>Los valores subrayados cambiaron en el último paso.</span>
    </p>
    <dl>
      {verbos.map(({ verbo, explicacion }) => (
        <div><dt>{verbo}</dt><dd>{explicacion}</dd></div>
      ))}
    </dl>
  </section>

  <p class="continuar">
    Para seguir comparando: <a href="/cuando-importa-el-orden/">Cuándo importa el orden</a>.
    Podés resolverlo en papel o en la carpeta.
  </p>
</PizarronLayout>

<script>
  import { iniciarSeguimiento } from "../../scripts/seguir-programa";
  iniciarSeguimiento();
</script>

<style>
  .pregunta {
    margin: 0 0 1rem;
    padding-left: 1rem;
    border-left: 4px solid var(--emphasis);
    font-size: clamp(1.2rem, 0.55vw + 1.05rem, 1.5rem);
    font-weight: 700;
    line-height: 1.35;
  }

  .caso { margin: 0 0 0.6rem; }
  .prediccion { margin: 0 0 1.4rem; font-weight: 700; }

  .ejecuciones {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .ejecucion { min-width: 0; }
  h2 { margin: 0 0 0.4rem; font-size: 1.1em; line-height: 1.3; }
  .controles[hidden], .leyenda[hidden] { display: none; }
  .paso { margin: 0.7rem 0 0.4rem; font-size: 0.9em; }
  .botones { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  button {
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--accent);
    border-radius: 0;
    background: var(--accent);
    color: var(--board);
    font: inherit;
    font-size: 0.9em;
    font-weight: 700;
    cursor: pointer;
  }

  [data-reiniciar] { background: transparent; color: var(--accent); }
  button:disabled { opacity: 0.5; cursor: default; }
  .ejecucion :global(tr.pendiente .valor) { visibility: hidden; }
  .ejecucion :global(tr.actual) { background: color-mix(in srgb, var(--accent) 10%, var(--board)); }
  .ejecucion :global(tr.actual th) { box-shadow: inset 3px 0 var(--accent); }
  .ejecucion :global(tr.actual td[data-cambio] .valor) { text-decoration: underline; text-underline-offset: 0.2em; }
  .comparacion { margin: 1.5rem 0; padding-left: 1rem; border-left: 4px solid var(--emphasis); font-weight: 700; }
  .comparacion[hidden] { display: none; }

  .referencia { margin-top: 1.5rem; padding-top: 1rem; border-top: 2px solid var(--line); }
  .referencia p { margin: 0.6rem 0; }
  dl { display: grid; gap: 0.4rem; margin: 1rem 0; }
  dl > div { display: flex; flex-wrap: wrap; gap: 0 0.4rem; }
  dt { font-weight: 700; }
  dt::after { content: ":"; }
  dd { margin: 0; }
  .continuar { margin: 1.5rem 0 0; }

  @media (max-width: 60rem) {
    .ejecuciones { grid-template-columns: 1fr; gap: 1.75rem; }
  }

  @media (max-width: 30rem) {
    .ejecucion :global(.seguimiento) { font-size: 0.8em; }
    .ejecucion :global(th), .ejecucion :global(td) { padding: 0.35rem 0.25rem; }
  }

  @media print {
    .controles, .leyenda, .continuar { display: none; }
    .ejecucion :global(tr.pendiente .valor) { visibility: visible; }
    .ejecucion :global(tr.actual) { background: none; }
    .ejecucion :global(tr.actual th) { box-shadow: none; }
    .ejecucion :global(tr.actual td[data-cambio] .valor) { text-decoration: none; }
    .comparacion[hidden] { display: block; }
    .ejecucion { break-inside: avoid; }
  }
</style>
