---
import TablaSeguimiento from "../../components/TablaSeguimiento.astro";
import {
  cantina,
  casoCantina,
  conclusion,
  ideaInicial,
  ordenCantinaCambiado,
  preguntaInicial,
  seguir,
  verbos,
} from "../../data/actividad-cuando-importa-el-orden";
import PizarronLayout from "../../layouts/PizarronLayout.astro";

const comoEsta = seguir(cantina);
const cambiado = seguir(cantina, ordenCantinaCambiado);
---

<PizarronLayout
  title="Seguir un programa paso a paso"
  description="Pizarrón sobre secuencia y orden: cada instrucción trabaja con los valores que hay en ese momento, y una tabla de seguimiento permite ver cómo cambia la memoria instrucción por instrucción."
  categoria="Pensamiento Computacional"
  encabezado="simple-grande"
>
  <p class="pregunta">{preguntaInicial}</p>

  <ul class="palabras" aria-label="Palabras clave">
    <li>Instrucción</li>
    <li>Memoria</li>
    <li>Valor</li>
    <li>Orden</li>
    <li>Tabla de seguimiento</li>
  </ul>

  <p class="idea">{ideaInicial}</p>

  <section class="verbos" aria-labelledby="verbos-titulo">
    <h2 id="verbos-titulo" class="rotulo">Qué hace cada instrucción</h2>
    <dl>
      {verbos.map(({ verbo, explicacion }) => (
        <div>
          <dt>{verbo}</dt>
          <dd>{explicacion}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="ejemplo" aria-labelledby="ejemplo-titulo">
    <h2 id="ejemplo-titulo" class="rotulo">Seguir el programa con una tabla</h2>
    <p class="caso">{casoCantina}</p>
    <ol class="programa">
      {cantina.instrucciones.map((instruccion) => <li>{instruccion.texto}</li>)}
    </ol>
    <p class="explicacion">
      Una fila por instrucción, en el orden en que se ejecutan. En cada fila se
      anota cuánto vale cada casillero después de esa instrucción; en
      «Pantalla», sólo lo que muestra «Mostrar».
    </p>
    <div class="tablas">
      <TablaSeguimiento
        titulo="Como está escrito"
        casilleros={cantina.casilleros}
        inicial={cantina.inicial}
        filas={comoEsta}
      />
      <TablaSeguimiento
        titulo="Con las instrucciones 1 y 2 intercambiadas"
        casilleros={cantina.casilleros}
        inicial={cantina.inicial}
        filas={cambiado}
      />
    </div>
    <p class="explicacion">
      Con las instrucciones intercambiadas, el programa cobra 2 empanadas aunque
      la cantidad ya es 3.
    </p>
  </section>

  <details class="cierre">
    <summary>Para cerrar, después de corregir la hoja</summary>
    <p>{conclusion}</p>
  </details>
</PizarronLayout>

<style>
  .pregunta {
    margin: 0 0 1.35rem;
    padding: 0.85rem 0 0.95rem 1rem;
    border-left: 4px solid var(--emphasis);
    color: var(--ink);
    font-size: clamp(1.2rem, 0.55vw + 1.05rem, 1.5rem);
    font-weight: 700;
    line-height: 1.35;
  }

  .palabras {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.55rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .palabras li {
    padding: 0.35rem 0.7rem;
    border: 2px solid var(--line);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .idea {
    margin: 0 0 1.75rem;
    padding: 1rem 1.15rem;
    background: var(--accent);
    color: var(--board);
    font-size: clamp(1.1rem, 0.4vw + 1rem, 1.3rem);
    font-weight: 700;
    line-height: 1.4;
  }

  .rotulo {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .verbos {
    margin: 0 0 1.75rem;
    padding: 1.1rem 0;
    border-top: 2px solid var(--line);
    border-bottom: 2px solid var(--line);
  }

  .verbos dl {
    display: grid;
    gap: 0.45rem;
    margin: 0;
  }

  .verbos dl > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
  }

  .verbos dt {
    font-weight: 700;
  }

  .verbos dt::after {
    content: ":";
  }

  .verbos dd {
    margin: 0;
  }

  .ejemplo .caso {
    margin: 0 0 0.6rem;
  }

  .programa {
    margin: 0 0 1rem;
    padding: 0.5rem 0 0.5rem 2.6rem;
    border-left: 4px solid var(--accent);
    font-weight: 700;
  }

  .explicacion {
    margin: 0 0 1rem;
    color: var(--muted);
    font-weight: 600;
  }

  .tablas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.5rem;
    margin: 0 0 1rem;
  }

  .cierre {
    margin: 1.5rem 0 0;
    padding-top: 1.1rem;
    border-top: 2px solid var(--line);
  }

  .cierre summary {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--accent);
    font-weight: 700;
    cursor: pointer;
  }

  .cierre summary:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .cierre p {
    margin: 0.4rem 0 0;
    font-size: clamp(1.08rem, 0.35vw + 1rem, 1.28rem);
    font-weight: 700;
    line-height: 1.4;
  }

  @media (max-width: 52rem) {
    .tablas {
      grid-template-columns: 1fr;
    }
  }
</style>
