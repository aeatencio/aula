---
import { casillerosPapelito } from "../../data/actividad-cuando-importa-el-orden";
import { serieCuandoImportaElOrden } from "../../data/serie-cuando-importa-el-orden";
import MaterialLayout from "../../layouts/MaterialLayout.astro";

const material = "Cuándo importa el orden";
const pdf =
  "/materiales/cuando-importa-el-orden/cuando-importa-el-orden-respuestas-oficio-216x356.pdf";

/** 2 columnas × 6 filas en una hoja oficio. */
const PAPELITOS = 12;
---

<MaterialLayout
  title="Papelitos de respuestas"
  description="Papelitos recortables para entregar las respuestas de «Cuándo importa el orden» antes de corregir: nombre, curso, fecha, lo que muestra la pantalla en cada programa y una letra por pregunta con opciones. Doce por hoja oficio."
  tipo="Para imprimir"
  bajada="Para entregar las respuestas antes de corregir en común"
  serie={serieCuandoImportaElOrden}
  tituloPizarrones="Para recuperar"
  imprimirPie={false}
>
  <p class="aviso">
    Doce papelitos por hoja oficio (216 × 356 mm), para recortar por las líneas
    punteadas. Cada estudiante anota nombre, curso y fecha y, en cada
    casillero, el número que muestra la pantalla o la letra que eligió. La
    primera fila corresponde al frente de la hoja; la segunda, al dorso.{" "}
    <a href={pdf} type="application/pdf">Papelitos en PDF</a>
  </p>

  <div class="hoja" aria-label={`${PAPELITOS} papelitos recortables`}>
    {Array.from({ length: PAPELITOS }, () => (
      <section class="papelito">
        <p class="titulo">{material}</p>
        <p class="campo">
          <span>Nombre y apellido</span>
          <span class="linea"></span>
        </p>
        <p class="campo campo--doble">
          <span>Curso</span>
          <span class="linea"></span>
          <span>Fecha</span>
          <span class="linea"></span>
        </p>
        {casillerosPapelito.map(({ cara, casilleros }) => (
          <div class="cara">
            <span class="cara-nombre">{cara}</span>
            <ol class="respuestas">
              {casilleros.map(({ numero, tipo }) => (
                <li>
                  <span class="numero">{numero}</span>
                  <span class:list={["casilla", `casilla--${tipo}`]}></span>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </section>
    ))}
  </div>
</MaterialLayout>

<style>
  .aviso {
    margin: 0 0 1.5rem;
    color: var(--muted);
    font-size: 1rem;
    font-weight: 600;
  }

  .aviso a {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
  }

  /* La hoja usa medidas físicas para que pantalla e impresión coincidan. */
  .hoja {
    display: grid;
    grid-template-columns: repeat(2, 100mm);
    grid-auto-rows: 55mm;
    width: 200mm;
    max-width: 100%;
    overflow-x: auto;
    border-top: 0.75pt dashed #000;
    border-left: 0.75pt dashed #000;
    background: #fff;
    color: #000;
  }

  .papelito {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2mm;
    min-width: 0;
    padding: 3mm 4.5mm;
    border-right: 0.75pt dashed #000;
    border-bottom: 0.75pt dashed #000;
    font-size: 9.5pt;
    line-height: 1.2;
  }

  .papelito p {
    margin: 0;
  }

  .titulo {
    margin-bottom: -0.6mm !important;
    font-size: 7pt;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .campo {
    display: flex;
    align-items: flex-end;
    gap: 2mm;
    white-space: nowrap;
  }

  .linea {
    flex: 1;
    height: 6mm;
    border-bottom: 0.75pt solid #000;
  }

  .cara {
    display: flex;
    align-items: center;
    gap: 2mm;
    margin-top: 0.6mm;
  }

  .cara-nombre {
    flex: 0 0 9mm;
    font-size: 7pt;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .respuestas {
    display: flex;
    gap: 2.6mm;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .respuestas li {
    display: flex;
    align-items: center;
    gap: 1mm;
  }

  .numero {
    font-size: 10.5pt;
    font-weight: 700;
  }

  .casilla {
    height: 8mm;
    border: 1pt solid #000;
  }

  /* Un número de hasta tres cifras o una letra. */
  .casilla--numero {
    width: 11mm;
  }

  .casilla--letra {
    width: 7.5mm;
  }

  /* Una hoja oficio: sólo los papelitos. */
  @page {
    size: 216mm 356mm;
    margin: 8mm;
  }

  @media print {
    :global(.material > .apertura),
    .aviso {
      display: none;
    }

    :global(.material) {
      max-width: none;
    }

    .hoja {
      max-width: none;
      overflow: visible;
    }

    .papelito {
      break-inside: avoid;
    }
  }
</style>
