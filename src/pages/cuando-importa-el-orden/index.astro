---
import ModeloCarpeta from "../../components/ModeloCarpeta.astro";
import TablaSeguimiento from "../../components/TablaSeguimiento.astro";
import {
  casoEjemplo,
  casoMonedas,
  casoNivel,
  consignasDorso,
  consignasFrente,
  ejemplo,
  formatear,
  ideaInicial,
  pausaDespuesDe,
  programaA,
  programaB,
  programaC,
  programaD,
  rutina,
  seguir,
  valorAntesDe,
  verbos,
  verbosDorso,
  type Programa,
} from "../../data/actividad-cuando-importa-el-orden";
import { serieCuandoImportaElOrden } from "../../data/serie-cuando-importa-el-orden";
import MaterialLayout from "../../layouts/MaterialLayout.astro";

const title = "Cuándo importa el orden";
const pdfHoja =
  "/materiales/cuando-importa-el-orden/cuando-importa-el-orden-oficio-216x356.pdf";

const inicio = (programa: Programa) =>
  programa.casilleros.map((c) => `${c}\u00a0=\u00a0${formatear(programa.inicial[c])}`).join(" y ");

const ejemplos = [
  { nombre: "Primero sumar", programa: ejemplo.primero },
  { nombre: "Primero duplicar", programa: ejemplo.segundo },
];
const duplicaEjemplo = ejemplos.map(({ programa }) => valorAntesDe(programa, "Duplicar"));

const antesDePausa = consignasFrente.filter((c) => c.numero <= pausaDespuesDe);
const consigna = (numero: number) => consignasFrente.find((c) => c.numero === numero)!;
const respuestasDorso = consignasDorso.map((c) => `${c.numero}: ${c.respuesta}`).join(" · ");
---

<MaterialLayout
  title={title}
  description="Actividad de Pensamiento Computacional en papel: seguir programas cortos con una tabla de seguimiento, anotando en la carpeta, y comparar cuándo cambiar el orden de las instrucciones cambia lo que se muestra."
  tipo="Actividad"
  bajada="Seguir programas paso a paso y comparar qué cambia cuando cambia el orden"
  serie={serieCuandoImportaElOrden}
  tituloPizarrones="Para recuperar"
  imprimirPie={false}
>
  <header class="hoja-cabecera">
    <p class="hoja-ubicacion">Pensamiento Computacional · Actividad</p>
    <p class="hoja-titulo">{title}</p>
  </header>

  <p class="hoja-pdf">
    Para imprimir:{" "}
    <a href={pdfHoja} type="application/pdf">la hoja en PDF</a>{" "}
    <span class="hoja-pdf-formato">(oficio 216 × 356 mm, doble faz)</span>.
    Va dentro de un folio: se lee y se consulta, no se escribe.
  </p>

  <p class="consigna-general">Esta hoja no se escribe. Anotá todo en la carpeta.</p>

  <section class="referencia" aria-label="Cómo seguir un programa">
    <p class="idea">{ideaInicial}</p>
    <div class="referencia-columnas">
      <div>
        <p class="referencia-titulo">Cómo seguir un programa</p>
        <ol class="rutina">
          {rutina.map((paso) => <li>{paso}</li>)}
        </ol>
      </div>
      <dl class="verbos">
        {verbos.map(({ verbo, explicacion }) => (
          <div>
            <dt>{verbo}</dt>
            <dd>{explicacion}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="parte" aria-labelledby="ejemplo">
    <h2 id="ejemplo" class="parte-titulo">Ejemplo resuelto</h2>
    <p class="caso-texto">{casoEjemplo} Las mismas instrucciones, en dos órdenes:</p>
    <div class="pares">
      {ejemplos.map(({ nombre, programa }) => (
        <TablaSeguimiento
          variante="hoja"
          titulo={nombre}
          casilleros={programa.casilleros}
          inicial={programa.inicial}
          filas={seguir(programa)}
        />
      ))}
    </div>
    <div class="ejemplo-pie">
      <ModeloCarpeta
        casilleros={ejemplo.primero.casilleros}
        inicial={ejemplo.primero.inicial}
        filas={seguir(ejemplo.primero)}
        titulo="Primero sumar"
      />
      <div class="ejemplo-notas">
        <p class="nota">
          En la carpeta, anotá sólo el número de cada instrucción y cómo queda, como en el recuadro.
        </p>
        <p class="destacado">
          «Duplicar» usa el valor que hay en ese momento: en el primero duplica{" "}
          {duplicaEjemplo[0]}; en el segundo, {duplicaEjemplo[1]}.
        </p>
      </div>
    </div>
  </section>

  <section class="parte" aria-labelledby="a-y-b">
    <h2 id="a-y-b" class="parte-titulo">A y B</h2>
    <p class="caso-texto">{casoNivel} Dos programas. Los dos empiezan con {inicio(programaA)}.</p>
    <div class="pares">
      {[["A", programaA], ["B", programaB]].map(([letra, programa]) => (
        <div class="programa-caja">
          <p class="programa-nombre">Programa {letra as string}</p>
          <ol class="programa">
            {(programa as Programa).instrucciones.map((instruccion) => <li>{instruccion.texto}</li>)}
          </ol>
        </div>
      ))}
    </div>
    <ol class="consignas" start={antesDePausa[0].numero}>
      {antesDePausa.map((c) => <li>{c.texto}</li>)}
    </ol>
    <p class="pausa">Cuando lo indique el docente, comparamos A y B entre todos.</p>
    <ol class="consignas" start={4}>
      <li>{consigna(4).texto}</li>
    </ol>
  </section>

  <section class="parte" aria-labelledby="c-y-d">
    <h2 id="c-y-d" class="parte-titulo">C y D</h2>
    <p class="caso-texto">Otros dos programas. También empiezan con {inicio(programaC)}.</p>
    <div class="pares">
      {[["C", programaC], ["D", programaD]].map(([letra, programa]) => (
        <div class="programa-caja">
          <p class="programa-nombre">Programa {letra as string}</p>
          <ol class="programa">
            {(programa as Programa).instrucciones.map((instruccion) => <li>{instruccion.texto}</li>)}
          </ol>
        </div>
      ))}
    </div>
    <ol class="consignas" start={5}>
      <li>{consigna(5).texto}</li>
    </ol>
  </section>

  {/* Dorso: para quien termina el frente. */}
  <section class="parte dorso" aria-labelledby="para-seguir">
    <h2 id="para-seguir" class="parte-titulo">Para seguir</h2>
    <p class="caso-texto">Si terminaste el frente, seguí acá. También se anota en la carpeta.</p>
    <p class="caso-texto">{casoMonedas}</p>
    <div class="dorso-referencia">
      <dl class="verbos verbos--dorso">
        {verbosDorso.map(({ verbo, explicacion }) => (
          <div>
            <dt>{verbo}</dt>
            <dd>{explicacion}</dd>
          </div>
        ))}
      </dl>
      <div>
        <p class="nota">En la carpeta, una columna por casillero:</p>
        <ModeloCarpeta
          casilleros={consignasDorso[0].programa.casilleros}
          inicial={consignasDorso[0].programa.inicial}
          filas={[]}
        />
      </div>
    </div>
    <p class="caso-texto">Cada programa empieza con {inicio(consignasDorso[0].programa)}.</p>
    <div class="dorso-programas">
      {consignasDorso.map((c) => (
        <div class="programa-caja">
          <ol class="programa">
            {c.programa.instrucciones.map((instruccion) => <li>{instruccion.texto}</li>)}
          </ol>
          <p class="consigna-dorso"><span class="numero">{c.numero}.</span> {c.texto}</p>
        </div>
      ))}
    </div>
    <p class="respuestas-dorso" aria-label="Para comprobar">
      <span>Para comprobar: {respuestasDorso}</span>
    </p>
  </section>

  <p class="hoja-pie">
    Para volver a mirar: pizarrón «Seguir un programa paso a paso» ·
    aula.andresatencio.com
  </p>
</MaterialLayout>

<style>
  /* Cabecera y pie de la hoja: sólo aparecen al imprimir. */
  .hoja-cabecera,
  .hoja-pie {
    display: none;
  }

  .hoja-pdf {
    margin: -0.75rem 0 1.5rem;
    padding: 0.6rem 0.9rem;
    border-left: 4px solid var(--accent);
    background: var(--board);
    font-size: 1rem;
  }

  .hoja-pdf a {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
  }

  .hoja-pdf a:hover {
    color: var(--accent);
  }

  .hoja-pdf-formato {
    color: var(--muted);
  }

  .consigna-general {
    margin: 0 0 1.25rem;
    font-size: 1.1em;
    font-weight: 700;
  }

  .referencia {
    margin: 0 0 2rem;
    padding: 0.9rem 1.1rem;
    border: 2px solid var(--line);
    background: var(--board);
  }

  .idea {
    margin: 0 0 0.8rem;
    font-weight: 700;
  }

  .referencia-columnas {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.5rem 2rem;
  }

  .referencia-titulo {
    margin: 0 0 0.3rem;
    font-weight: 700;
  }

  .rutina {
    margin: 0;
    padding-left: 1.5rem;
  }

  .verbos {
    display: grid;
    gap: 0.3rem;
    align-content: start;
    margin: 0;
  }

  .verbos dt {
    display: inline;
    font-weight: 700;
  }

  .verbos dt::after {
    content: ": ";
  }

  .verbos dd {
    display: inline;
    margin: 0;
  }

  .parte + .parte {
    margin-top: 2.25rem;
  }

  .parte-titulo {
    margin: 0 0 0.9rem;
    padding-bottom: 0.45rem;
    border-bottom: 2px solid var(--line);
    font-size: clamp(1.15rem, 0.35vw + 1.05rem, 1.35rem);
  }

  .caso-texto {
    margin: 0 0 0.9rem;
  }

  .pares {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.5rem;
    margin: 0 0 1rem;
  }

  .ejemplo-pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  .nota {
    margin: 0 0 0.4rem;
    font-size: 0.95em;
  }

  .ejemplo-notas {
    flex: 1 1 16rem;
  }

  .ejemplo-notas .nota {
    margin-bottom: 0.8rem;
  }

  .destacado {
    margin: 0;
    padding-left: 1rem;
    border-left: 4px solid var(--emphasis);
    font-weight: 700;
  }

  .programa-caja {
    min-width: 0;
    padding: 0.6rem 0.9rem;
    border: 2px solid var(--line);
  }

  .programa-nombre {
    margin: 0 0 0.3rem;
    font-weight: 700;
  }

  .programa {
    margin: 0;
    padding-left: 1.6rem;
    font-weight: 700;
  }

  .consignas {
    margin: 0;
    padding-left: 1.8rem;
  }

  .consignas li + li {
    margin-top: 0.5rem;
  }

  .consignas li::marker {
    color: var(--accent);
    font-weight: 700;
  }

  .pausa {
    margin: 0.9rem 0;
    padding: 0.5rem 0.9rem;
    border: 2px dashed var(--accent);
    font-weight: 700;
  }

  .dorso-referencia {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1rem 2rem;
    margin: 0 0 1rem;
  }

  .verbos--dorso {
    flex: 1 1 18rem;
  }

  .dorso-programas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.5rem;
  }

  .consigna-dorso {
    margin: 0.5rem 0 0;
  }

  .consigna-dorso .numero {
    color: var(--accent);
    font-weight: 700;
  }

  .respuestas-dorso {
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: 0.9em;
    text-align: center;
  }

  /* Las respuestas, cabeza abajo: para comprobar, no para mirar antes. */
  .respuestas-dorso span {
    display: inline-block;
    transform: rotate(180deg);
  }

  @media (max-width: 40rem) {
    .referencia-columnas,
    .pares,
    .dorso-programas {
      grid-template-columns: 1fr;
    }
  }

  /* Una hoja oficio (216 × 356 mm) doble faz, en blanco y negro, para un
     folio: no hay lugar para escribir. Frente: núcleo; dorso: Para seguir. */
  @page {
    size: 216mm 356mm;
    margin: 9mm 15mm 10mm;
  }

  @media print {
    :global(body),
    :global(.material) {
      color: #000;
      font-size: 12pt;
      line-height: 1.32;
    }

    :global(.material > .apertura) {
      display: none;
    }

    .hoja-cabecera {
      display: block;
      margin: 0 0 3mm;
      padding-bottom: 1.5mm;
      border-bottom: 1.5pt solid #000;
    }

    .hoja-ubicacion {
      margin: 0;
      font-size: 8.5pt;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .hoja-titulo {
      margin: 0.5mm 0 0;
      font-size: 17pt;
      font-weight: 700;
      line-height: 1.15;
    }

    .hoja-pdf {
      display: none !important;
    }

    .consigna-general {
      margin: 0 0 2.5mm;
      font-size: 12pt;
    }

    .referencia {
      margin: 0 1pt 3mm 0;
      padding: 2mm 3.5mm;
      border: 1pt solid #000;
      background: none;
      break-inside: avoid;
    }

    .idea {
      margin-bottom: 1.5mm;
    }

    .referencia-columnas {
      gap: 0 6mm;
    }

    .parte + .parte {
      margin-top: 3.5mm;
    }

    .parte-titulo {
      margin: 0 0 2mm;
      padding-bottom: 0.8mm;
      border-bottom: 1pt solid #000;
      font-size: 11.5pt;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .caso-texto {
      margin: 0 0 2mm;
    }

    .pares {
      gap: 2mm 6mm;
      margin: 0 1pt 2.5mm 0;
    }

    .ejemplo-pie {
      gap: 2mm 6mm;
    }

    .nota {
      margin-bottom: 1mm;
      font-size: 10pt;
    }

    .ejemplo-notas .nota {
      margin-bottom: 2.5mm;
    }

    .destacado {
      padding-left: 3mm;
      border-left: 2pt solid #000;
    }

    .programa-caja {
      padding: 1.5mm 3mm;
      border: 1pt solid #000;
      break-inside: avoid;
    }

    .programa-nombre {
      margin-bottom: 0.8mm;
    }

    .programa {
      padding-left: 6mm;
    }

    .consignas {
      padding-left: 7mm;
    }

    .consignas li + li {
      margin-top: 1.2mm;
    }

    .consignas li::marker {
      color: #000;
    }

    .pausa {
      margin: 2.5mm 1pt 2.5mm 0;
      padding: 1.2mm 3mm;
      border: 1pt dashed #000;
    }

    .dorso {
      break-before: page;
      margin-top: 0 !important;
    }

    .dorso-referencia {
      gap: 2mm 8mm;
      margin-bottom: 3mm;
    }

    .dorso-programas {
      gap: 4mm 6mm;
      margin-right: 1pt;
    }

    .consigna-dorso {
      margin-top: 1.5mm;
    }

    .consigna-dorso .numero {
      color: #000;
    }

    .respuestas-dorso {
      margin-top: 8mm;
      color: #000;
      font-size: 9pt;
    }

    .hoja-pie {
      display: block;
      margin: 4mm 0 0;
      padding-top: 1mm;
      border-top: 0.5pt solid #000;
      font-size: 8.5pt;
    }
  }
</style>
